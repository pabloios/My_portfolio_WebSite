# Copia este archivo como .env y completa los valores.
# En Vercel: Project Settings → Environment Variables.

# Clave de OpenRouter para el chat "Pablo AI" (https://openrouter.ai/keys)
OPENROUTER_API_KEY=

# URL pública del sitio (sin barra final). Se usa para SEO, sitemap,
# robots, Open Graph y el header HTTP-Referer hacia OpenRouter.
# Ejemplo: https://pablo-sarmiento.vercel.app
NEXT_PUBLIC_SITE_URL=
